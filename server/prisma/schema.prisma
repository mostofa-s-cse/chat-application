generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // or postgresql, sqlite, etc.
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                       @id @default(autoincrement())
  firstName            String
  lastName             String                    @unique
  email                String?                   @unique
  phone                String?                   @unique
  avatar               String?
  status               String?
  createdAt            DateTime                  @default(now())
  bio                  String?
  lastSeen             DateTime?                 @default(now())
  isVerified           Boolean                   @default(false)
  otp                  String?
  otpExpiry            DateTime?
  googleId             String?                   @unique
  refreshToken         String?
  conversationsCreated Conversation[]            @relation("ConversationCreator")
  participants         ConversationParticipant[]
  sentMessages         Message[]                 @relation("MessageSender")
  receivedStatuses     MessageStatus[]           @relation("StatusRecipient")
  invitedGroups        GroupInvite[]             @relation("GroupInvited")
  sentInvites          GroupInvite[]             @relation("GroupInviter")
  callLogsInitiated    CallLog[]                 @relation("Caller")
  callLogsReceived     CallLog[]                 @relation("Receiver")
}

model Conversation {
  id        Int      @id @default(autoincrement())
  isGroup   Boolean  @default(false)
  name      String?
  createdAt DateTime @default(now())

  createdById  Int
  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
  invites      GroupInvite[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  user           User         @relation(fields: [userId], references: [id])
  userId         Int
  role           String       @default("member")
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  senderId       Int
  messageType    String // "text", "image", etc.
  content        String?
  fileUrl        String?
  createdAt      DateTime     @default(now())
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  replyToId      Int?
  replies        Message[]    @relation("MessageReply")

  statuses    MessageStatus[]
  attachments Attachment[]
}

model MessageStatus {
  id          Int      @id @default(autoincrement())
  message     Message  @relation(fields: [messageId], references: [id])
  messageId   Int
  recipient   User     @relation("StatusRecipient", fields: [recipientId], references: [id])
  recipientId Int
  status      String // "sent", "delivered", "seen"
  updatedAt   DateTime @default(now())

  @@unique([messageId, recipientId])
}

model Attachment {
  id         Int      @id @default(autoincrement())
  message    Message  @relation(fields: [messageId], references: [id])
  messageId  Int
  fileType   String
  fileUrl    String
  fileSize   Int
  uploadedAt DateTime @default(now())
}

model GroupInvite {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  invitedUser    User         @relation("GroupInvited", fields: [invitedUserId], references: [id])
  invitedUserId  Int
  invitedBy      User         @relation("GroupInviter", fields: [invitedById], references: [id])
  invitedById    Int
  status         String // "pending", "accepted", "rejected"
  createdAt      DateTime     @default(now())
}

model CallLog {
  id           Int      @id @default(autoincrement())
  caller       User     @relation("Caller", fields: [callerId], references: [id])
  callerId     Int
  receiver     User     @relation("Receiver", fields: [receiverId], references: [id])
  receiverId   Int
  callType     String // "audio" or "video"
  startedAt    DateTime
  endedAt      DateTime
  durationSecs Int
}
